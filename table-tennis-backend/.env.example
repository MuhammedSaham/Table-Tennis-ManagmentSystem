# ==============================================
# TABLE TENNIS TOURNAMENT MANAGEMENT SYSTEM
# Environment Variables Template
# ==============================================
# Copy this file and rename it to .env
# Fill in your own values — never share .env
# ==============================================

# ─────────────────────────────────────────────
# Database
# Replace YOUR_PASSWORD with your PostgreSQL
# password you set during installation
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:Fasna%402001@localhost:5432/table_tennis_db"

# ─────────────────────────────────────────────
# App Configuration
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────
# Security
# Make up any long random string for JWT_SECRET
# ─────────────────────────────────────────────
JWT_SECRET="make-up-any-long-random-string-here"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
CORS_ORIGIN="*"

# ─────────────────────────────────────────────
# Rate Limiting
# Leave these as they are
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─────────────────────────────────────────────
# Email Configuration (for password reset)
# Step 1 — Go to myaccount.google.com
# Step 2 — Security → 2-Step Verification → ON
# Step 3 — Security → App Passwords → generate
# Step 4 — Paste the 16 characters in EMAIL_PASS
# ─────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_FROM=your-gmail@gmail.com

# ─────────────────────────────────────────────
# Frontend URL
# ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173